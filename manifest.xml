<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0" xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="TaskPaneApp">
  <Id>e02e08a1-360c-4f28-9df4-b85c13964cf4</Id>
  <Version>1.1.1.0</Version>
  <ProviderName>Contoso</ProviderName>
  <DefaultLocale>ja-JP</DefaultLocale>
  <DisplayName DefaultValue="Quick Fill Color"/>
  <Description DefaultValue="選択セルを業務別の色で塗り分けます。共有ランタイム・自動先読み対応。"/>
  <IconUrl DefaultValue="https://takehana-tokushu.github.io/excel-quick-fill-color/assets/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://takehana-tokushu.github.io/excel-quick-fill-color/assets/icon-64.png"/>
  <SupportUrl DefaultValue="https://www.contoso.com/help"/>
  <AppDomains>
    <AppDomain>https://takehana-tokushu.github.io</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Workbook"/>
  </Hosts>
  <Requirements>
    <Sets DefaultMinVersion="1.1">
      <Set Name="SharedRuntime" MinVersion="1.1"/>
      <Set Name="ExcelApi" MinVersion="1.9"/>
    </Sets>
  </Requirements>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://takehana-tokushu.github.io/excel-quick-fill-color/runtime-v1.1.1.html"/>
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Workbook">
        <Runtimes>
          <Runtime resid="Taskpane.Url" lifetime="long"/>
        </Runtimes>
        <DesktopFormFactor>
          <GetStarted>
            <Title resid="GetStarted.Title"/>
            <Description resid="GetStarted.Description"/>
            <LearnMoreUrl resid="GetStarted.LearnMoreUrl"/>
          </GetStarted>
          <FunctionFile resid="Taskpane.Url"/>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="QuickFillGroup">
                <Label resid="QuickFillGroup.Label"/>
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16"/>
                  <bt:Image size="32" resid="Icon.32x32"/>
                  <bt:Image size="80" resid="Icon.80x80"/>
                </Icon>
                <Control xsi:type="Button" id="FillYellowButton">
                  <Label resid="FillYellow.Label"/>
                  <Supertip>
                    <Title resid="FillYellow.Label"/>
                    <Description resid="FillYellow.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="IconYellow.16x16"/>
                    <bt:Image size="32" resid="IconYellow.32x32"/>
                    <bt:Image size="80" resid="IconYellow.80x80"/>
                  </Icon>
                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>fillYellow</FunctionName>
                  </Action>
                </Control>
                <Control xsi:type="Button" id="FillOrangeButton">
                  <Label resid="FillOrange.Label"/>
                  <Supertip>
                    <Title resid="FillOrange.Label"/>
                    <Description resid="FillOrange.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="IconOrange.16x16"/>
                    <bt:Image size="32" resid="IconOrange.32x32"/>
                    <bt:Image size="80" resid="IconOrange.80x80"/>
                  </Icon>
                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>fillOrange</FunctionName>
                  </Action>
                </Control>
                <Control xsi:type="Button" id="FillBlueButton">
                  <Label resid="FillBlue.Label"/>
                  <Supertip>
                    <Title resid="FillBlue.Label"/>
                    <Description resid="FillBlue.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="IconBlue.16x16"/>
                    <bt:Image size="32" resid="IconBlue.32x32"/>
                    <bt:Image size="80" resid="IconBlue.80x80"/>
                  </Icon>
                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>fillBlue</FunctionName>
                  </Action>
                </Control>
                <Control xsi:type="Button" id="FillGrayButton">
                  <Label resid="FillGray.Label"/>
                  <Supertip>
                    <Title resid="FillGray.Label"/>
                    <Description resid="FillGray.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="IconGray.16x16"/>
                    <bt:Image size="32" resid="IconGray.32x32"/>
                    <bt:Image size="80" resid="IconGray.80x80"/>
                  </Icon>
                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>fillGray</FunctionName>
                  </Action>
                </Control>
                <Control xsi:type="Button" id="ClearFillButton">
                  <Label resid="ClearFill.Label"/>
                  <Supertip>
                    <Title resid="ClearFill.Label"/>
                    <Description resid="ClearFill.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="IconClear.16x16"/>
                    <bt:Image size="32" resid="IconClear.32x32"/>
                    <bt:Image size="80" resid="IconClear.80x80"/>
                  </Icon>
                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>clearFill</FunctionName>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://takehana-tokushu.github.io/excel-quick-fill-color/assets/icon-16.png"/>
        <bt:Image id="Icon.32x32" DefaultValue="https://takehana-tokushu.github.io/excel-quick-fill-color/assets/icon-32.png"/>
        <bt:Image id="Icon.80x80" DefaultValue="https://takehana-tokushu.github.io/excel-quick-fill-color/assets/icon-80.png"/>
        <bt:Image id="IconYellow.16x16" DefaultValue="https://takehana-tokushu.github.io/excel-quick-fill-color/assets/yellow-16.png"/>
        <bt:Image id="IconYellow.32x32" DefaultValue="https://takehana-tokushu.github.io/excel-quick-fill-color/assets/yellow-32.png"/>
        <bt:Image id="IconYellow.80x80" DefaultValue="https://takehana-tokushu.github.io/excel-quick-fill-color/assets/yellow-80.png"/>
        <bt:Image id="IconOrange.16x16" DefaultValue="https://takehana-tokushu.github.io/excel-quick-fill-color/assets/orange-16.png"/>
        <bt:Image id="IconOrange.32x32" DefaultValue="https://takehana-tokushu.github.io/excel-quick-fill-color/assets/orange-32.png"/>
        <bt:Image id="IconOrange.80x80" DefaultValue="https://takehana-tokushu.github.io/excel-quick-fill-color/assets/orange-80.png"/>
        <bt:Image id="IconBlue.16x16" DefaultValue="https://takehana-tokushu.github.io/excel-quick-fill-color/assets/blue-16.png"/>
        <bt:Image id="IconBlue.32x32" DefaultValue="https://takehana-tokushu.github.io/excel-quick-fill-color/assets/blue-32.png"/>
        <bt:Image id="IconBlue.80x80" DefaultValue="https://takehana-tokushu.github.io/excel-quick-fill-color/assets/blue-80.png"/>
        <bt:Image id="IconGray.16x16" DefaultValue="https://takehana-tokushu.github.io/excel-quick-fill-color/assets/gray-16.png"/>
        <bt:Image id="IconGray.32x32" DefaultValue="https://takehana-tokushu.github.io/excel-quick-fill-color/assets/gray-32.png"/>
        <bt:Image id="IconGray.80x80" DefaultValue="https://takehana-tokushu.github.io/excel-quick-fill-color/assets/gray-80.png"/>
        <bt:Image id="IconClear.16x16" DefaultValue="https://takehana-tokushu.github.io/excel-quick-fill-color/assets/clear-16.png"/>
        <bt:Image id="IconClear.32x32" DefaultValue="https://takehana-tokushu.github.io/excel-quick-fill-color/assets/clear-32.png"/>
        <bt:Image id="IconClear.80x80" DefaultValue="https://takehana-tokushu.github.io/excel-quick-fill-color/assets/clear-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="GetStarted.LearnMoreUrl" DefaultValue="https://go.microsoft.com/fwlink/?LinkId=276812"/>
        <bt:Url id="Commands.Url" DefaultValue="https://takehana-tokushu.github.io/excel-quick-fill-color/runtime-v1.1.1.html"/>
        <bt:Url id="Taskpane.Url" DefaultValue="https://takehana-tokushu.github.io/excel-quick-fill-color/runtime-v1.1.1.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GetStarted.Title" DefaultValue="Get started with Quick Fill Color!"/>
        <bt:String id="QuickFillGroup.Label" DefaultValue="Quick Fill"/>
        <bt:String id="FillYellow.Label" DefaultValue="予約"/>
        <bt:String id="FillOrange.Label" DefaultValue="移動"/>
        <bt:String id="FillBlue.Label" DefaultValue="バラし"/>
        <bt:String id="FillGray.Label" DefaultValue="停止"/>
        <bt:String id="ClearFill.Label" DefaultValue="クリア"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="GetStarted.Description" DefaultValue="Quick Fill Color add-in loaded successfully. Go to the HOME tab and use the Quick Fill buttons."/>
        <bt:String id="FillYellow.Tooltip" DefaultValue="選択したセルを予約として塗りつぶします"/>
        <bt:String id="FillOrange.Tooltip" DefaultValue="選択したセルを移動として塗りつぶします"/>
        <bt:String id="FillBlue.Tooltip" DefaultValue="選択したセルをバラしとして塗りつぶします"/>
        <bt:String id="FillGray.Tooltip" DefaultValue="選択したセルを停止として塗りつぶします"/>
        <bt:String id="ClearFill.Tooltip" DefaultValue="選択したセルの塗りつぶしをクリアします"/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
